@@ -0,0 +1,71 @@
+"""Supervise both services; expose only the authenticated Next.js entry point."""
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+from urllib.request import urlopen
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    os.umask(0o077)
+    env = dict(os.environ)
+    if env.get('BOOTHFORGE_ENV', 'preview') != 'preview':
+        raise SystemExit('The deployment launcher requires BOOTHFORGE_ENV=preview')
+    env['BOOTHFORGE_ENV'] = 'preview'
+    env.setdefault('API_INTERNAL_URL', 'http://127.0.0.1:8000')
+    # Provider credentials are deliberately not passed to either pilot process.
+    for key in list(env):
+        if key.startswith(('OPENAI_', 'GOOGLE_', 'GEMINI_')):
+            del env[key]
+    children = []
+
+    def stop(*_):
+        for child in children:
+            if child.poll() is None:
+                child.terminate()
+        deadline = time.monotonic() + 12
+        for child in children:
+            try:
+                child.wait(timeout=max(0.1, deadline - time.monotonic()))
+            except subprocess.TimeoutExpired:
+                child.kill()
+                child.wait()
+
+    def on_signal(*_):
+        stop()
+        raise SystemExit(0)
+
+    signal.signal(signal.SIGTERM, on_signal)
+    signal.signal(signal.SIGINT, on_signal)
+    try:
+        api_env = {k: v for k, v in env.items() if not k.startswith('PREVIEW_')}
+        api = subprocess.Popen([sys.executable, '-m', 'uvicorn', 'app.main:app',
+                                '--host', '127.0.0.1', '--port', '8000', '--no-access-log'],
+                               cwd=ROOT / 'services/api', env=api_env)
+        children.append(api)
+        for _ in range(100):
+            if api.poll() is not None:
+                raise RuntimeError('API failed to start')
+            try:
+                with urlopen('http://127.0.0.1:8000/health', timeout=1) as response:
+                    if response.status == 200:
+                        break
+            except OSError:
+                time.sleep(0.1)
+        else:
+            raise RuntimeError('API readiness timed out')
+        web = subprocess.Popen(['node', 'server.mjs'], cwd=ROOT / 'apps/web', env=env)
+        children.append(web)
+        while all(child.poll() is None for child in children):
+            time.sleep(0.25)
+        raise RuntimeError('A service exited; stopping the other service')
+    finally:
+        stop()
+
+
+if __name__ == '__main__':
+    main()

+'use client';
+
+import { useEffect, useState } from 'react';
+
+type Project = { id: string; name: string; client: string; area_m2: number; status: string };
+const API = '/api';
+const inputStyle = {
+  background: '#18202c', border: '1px solid #344153', borderRadius: 9,
+  color: 'white', padding: 12, width: '100%', boxSizing: 'border-box' as const,
+  fontSize: 16, minHeight: 44,
+};
+const panelStyle = { background: '#131b27', padding: 24, borderRadius: 18, minWidth: 0 };
+
+export default function Dashboard() {
+  const [projects, setProjects] = useState<Project[]>([]);
+  const [error, setError] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [fetching, setFetching] = useState(true);
+  const [form, setForm] = useState({
+    name: '', client: '', industry: '', length_m: 6, width_m: 4, height_m: 4, open_sides: 2,
+    requirements: { reception: 1, screens: 1, meeting_rooms: 0, storage: false, notes: '' },
+  });
+
+  async function refresh() {
+    setFetching(true);
+    setError('');
+    try {
+      const response = await fetch(`${API}/projects`, { cache: 'no-store' });
+      if (!response.ok) throw new Error('Project request failed');
+      setProjects(await response.json());
+    } catch {
+      setError('تعذر تحميل المشاريع. تحقق من اتصالك وحاول مجددًا.');
+    } finally {
+      setFetching(false);
+    }
+  }
+
+  useEffect(() => { void refresh(); }, []);
+
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    setLoading(true);
+    setError('');
+    try {
+      const response = await fetch(`${API}/projects`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(form),
+      });
+      if (!response.ok) {
+        setError(response.status === 422 ? 'تحقق من الحقول والأبعاد المدخلة.' : 'تعذر حفظ المشروع. حاول مجددًا.');
+        return;
+      }
+      setForm({ ...form, name: '', client: '', industry: '' });
+      await refresh();
+    } catch {
+      setError('تعذر الاتصال بخادم المشاريع. حاول مجددًا.');
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  return (
+    <main style={{ maxWidth: 1100, margin: 'auto', padding: 24 }}>
+      <header style={{ padding: '30px 0', borderBottom: '1px solid #30394a' }}>
+        <h1 style={{ fontSize: 38, margin: 0 }}>BOOTHFORGE <span style={{ color: '#7df0c2' }}>AI</span></h1>
+        <p style={{ color: '#a5b0c3' }}>From Concept to Construction — منصة تصميم أجنحة المعارض</p>
+      </header>
+      <section style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(min(100%,300px),1fr))', gap: 24, marginTop: 30, alignItems: 'start' }}>
+        <form onSubmit={submit} aria-busy={loading} style={{ ...panelStyle, display: 'grid', gap: 14 }}>
+          <h2>مشروع جديد</h2>
+          {(['name', 'client', 'industry'] as const).map(key => (
+            <label key={key}>
+              {({ name: 'اسم المشروع', client: 'اسم العميل', industry: 'نشاط الشركة' })[key]}
+              <input required minLength={2} maxLength={120} disabled={loading} style={inputStyle}
+                value={form[key]} onChange={e => setForm({ ...form, [key]: e.target.value })} />
+            </label>
+          ))}
+          {(['length_m', 'width_m', 'height_m', 'open_sides'] as const).map(key => (
+            <label key={key}>
+              {({ length_m: 'الطول بالمتر', width_m: 'العرض بالمتر', height_m: 'الارتفاع بالمتر', open_sides: 'عدد الجهات المفتوحة' })[key]}
+              <input type="number" required disabled={loading} min={key === 'open_sides' ? 1 : 0.1}
+                max={key === 'open_sides' ? 4 : key === 'height_m' ? 20 : 100}
+                step={key === 'open_sides' ? 1 : 0.1} style={inputStyle} value={form[key]}
+                onChange={e => setForm({ ...form, [key]: Number(e.target.value) })} />
+            </label>
+          ))}
+          <fieldset disabled={loading} style={{ border: '1px solid #344153', borderRadius: 9, display: 'grid', gap: 10, minWidth: 0 }}>
+            <legend>متطلبات البوث</legend>
+            {(['reception', 'screens', 'meeting_rooms'] as const).map(key => (
+              <label key={key}>
+                {({ reception: 'كاونترات الاستقبال', screens: 'الشاشات', meeting_rooms: 'غرف الاجتماعات' })[key]}
+                <input type="number" min={0} max={key === 'screens' ? 50 : 20} required style={inputStyle}
+                  value={form.requirements[key]}
+                  onChange={e => setForm({ ...form, requirements: { ...form.requirements, [key]: Number(e.target.value) } })} />
+              </label>
+            ))}
+            <label style={{ display: 'flex', alignItems: 'center', gap: 10, minHeight: 44, cursor: 'pointer' }}>
+              <input type="checkbox" style={{ width: 24, height: 24, flexShrink: 0, margin: 0 }} checked={form.requirements.storage}
+                onChange={e => setForm({ ...form, requirements: { ...form.requirements, storage: e.target.checked } })} />
+              مستودع
+            </label>
+            <label>
+              ملاحظات
+              <textarea maxLength={4000} rows={3} style={inputStyle} value={form.requirements.notes}
+                onChange={e => setForm({ ...form, requirements: { ...form.requirements, notes: e.target.value } })} />
+            </label>
+          </fieldset>
+          <p>المساحة: {(form.length_m * form.width_m).toFixed(2)} م²</p>
+          <button disabled={loading} style={{ padding: 15, background: '#7df0c2', border: 0, borderRadius: 10, fontWeight: 700, cursor: 'pointer', minHeight: 44 }}>
+            {loading ? 'جارٍ الحفظ...' : 'إنشاء المشروع'}
+          </button>
+          {error && <p role="alert" aria-label="رسالة خطأ" style={{ color: '#ff9b9b' }}>{error}</p>}
+        </form>
+        <div style={panelStyle} aria-busy={fetching}>
+          <h2>المشاريع المحفوظة</h2>
+          <button type="button" disabled={fetching} onClick={() => void refresh()} style={{ minHeight: 44, marginBottom: 16 }}>
+            تحديث المشاريع
+          </button>
+          {fetching ? <p role="status">جارٍ تحميل المشاريع...</p> : projects.length === 0 ? (
+            <p style={{ color: '#a5b0c3' }}>لا توجد مشاريع حتى الآن.</p>
+          ) : projects.map(project => (
+            <article key={project.id} style={{ padding: 16, background: '#202a39', borderRadius: 12, marginBottom: 12, overflowWrap: 'anywhere' }}>
+              <strong>{project.name}</strong>
+              <p>{project.client} • {project.area_m2} م²</p>
+              <small>{project.status === 'draft' ? 'مسودة' : project.status}</small>
+            </article>
+          ))}
+          <p style={{ color: '#a5b0c3', fontSize: 13 }}>نسخة خاصة لفريق واحد. استخدم بيانات اختبار فقط. توليد الصور وربط CAD قيد التطوير. لا يتم عرض نتائج وهمية.</p>
+        </div>
+      </section>
+    </main>
+  );
+}

@@ -0,0 +1,98 @@
+"""Real production-mode HTTP tests. Uses disposable synthetic data, no AI calls."""
+import base64
+import json
+import os
+import secrets
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+from urllib.error import HTTPError
+from urllib.request import Request, urlopen
+
+ROOT = Path(__file__).resolve().parents[1]
+ORIGIN = 'https://pilot.example.test'
+
+
+def main():
+    token, password = secrets.token_urlsafe(32), secrets.token_urlsafe(24)
+    basic = 'Basic ' + base64.b64encode(f'pilot:{password}'.encode()).decode()
+    checks = 0
+    with tempfile.TemporaryDirectory(prefix='boothforge-smoke-') as directory:
+        env = {**os.environ, 'BOOTHFORGE_ENV': 'preview', 'API_TOKEN': token,
+               'PREVIEW_USERNAME': 'pilot', 'PREVIEW_PASSWORD': password,
+               'APP_ORIGIN': ORIGIN, 'DATA_DIR': directory, 'PORT': '3100',
+               'BIND_HOST': '127.0.0.1', 'NEXT_TELEMETRY_DISABLED': '1'}
+        with open(Path(directory) / 'runtime.log', 'w+') as log:
+            process = subprocess.Popen([sys.executable, str(ROOT / 'scripts/run_preview.py')], env=env, stdout=log, stderr=log)
+            try:
+                def request(path, method='GET', data=None, auth=basic, origin=None, port=3100, headers=None):
+                    nonlocal checks
+                    h = dict(headers or {})
+                    if auth:
+                        h['Authorization'] = auth
+                    if origin:
+                        h['Origin'] = origin
+                    if data is not None:
+                        h['Content-Type'] = 'application/json'
+                        data = json.dumps(data).encode()
+                    try:
+                        response = urlopen(Request(f'http://127.0.0.1:{port}{path}', data=data, method=method, headers=h), timeout=15)
+                    except HTTPError as exc:
+                        response = exc
+                    checks += 1
+                    return response.status, response.read(), response.headers
+
+                for _ in range(200):
+                    if process.poll() is not None:
+                        raise AssertionError('Preview process failed to start')
+                    try:
+                        if request('/health', auth=None)[0] == 200:
+                            break
+                    except OSError:
+                        time.sleep(0.1)
+                else:
+                    raise AssertionError('Web readiness timed out')
+
+                assert request('/', auth=None)[0] == 401
+                assert request('/api/projects', auth=None, headers={'x-middleware-subrequest': 'middleware:middleware:middleware:middleware:middleware'})[0] == 401
+                assert request('/_next/static/test.js', auth=None)[0] == 401
+                status, body, headers = request('/')
+                assert status == 200 and b'BOOTHFORGE' in body
+                assert headers['Cache-Control'] == 'no-store'
+                for secret in (token, password):
+                    assert secret.encode() not in body
+                assert request('/api/projects')[0] == 200
+                payload = {'name': 'Synthetic booth', 'client': 'Synthetic client', 'industry': 'Events',
+                           'length_m': 6, 'width_m': 4, 'height_m': 4, 'open_sides': 2,
+                           'requirements': {'screens': 2, 'storage': True}}
+                assert request('/api/projects', 'POST', payload)[0] == 403
+                assert request('/api/projects', 'POST', payload, origin='https://evil.test')[0] == 403
+                status, body, _ = request('/api/projects', 'POST', payload, origin=ORIGIN)
+                assert status == 201
+                project = json.loads(body)
+                assert project['area_m2'] == 24 and project['requirements']['screens'] == 2
+                assert request('/api/projects/' + project['id'])[0] == 200
+                assert request('/api/projects/' + project['id'] + '/concepts', 'POST', {'count': 3}, origin=ORIGIN)[0] == 501
+                assert request('/api/projects', 'POST', {**payload, 'height_m': 21}, origin=ORIGIN)[0] == 422
+                assert request('/api/health')[0] == 404
+                assert request('/api/projects?anything=1')[0] == 404
+                assert request('/projects', port=8000, auth=None)[0] == 401
+                assert request('/projects', port=8000, auth='Bearer ' + token)[0] == 200
+                assert request('/projects', port=8000, auth=basic)[0] == 401
+                # Authentication failures are bounded even on a reverse-proxied endpoint.
+                statuses = [request('/', auth=None)[0] for _ in range(21)]
+                assert 429 in statuses
+                print(f'PASS: {checks} HTTP checks against real Next.js and FastAPI; no provider calls')
+            finally:
+                process.terminate()
+                try:
+                    process.wait(timeout=20)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+
+
+if __name__ == '__main__':
+    main()

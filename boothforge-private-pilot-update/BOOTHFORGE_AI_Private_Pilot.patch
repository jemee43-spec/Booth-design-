+import { defineConfig } from '@playwright/test';
+export default defineConfig({
+  testDir: './e2e',
+  testMatch: '*.spec.ts',
+  timeout: 30000,
+  workers: 1,
+  reporter: 'list',
+  use: {
+    baseURL: 'https://localhost:3443',
+    ignoreHTTPSErrors: true, // The test harness generates a disposable local TLS certificate.
+    httpCredentials: {
+      username: process.env.BOOTHFORGE_E2E_USERNAME || 'pilot',
+      password: process.env.BOOTHFORGE_E2E_PASSWORD || '',
+    },
+    launchOptions: {
+      executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH || undefined,
+      args: JSON.parse(process.env.PLAYWRIGHT_CHROMIUM_ARGS || '[]'),
+    },
+  },
+  projects: [
+    { name: 'desktop', use: { viewport: { width: 1440, height: 1000 } } },
+    { name: 'mobile', use: { viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true } },
+  ],
+});
diff --git a/boothforge-ai/apps/web/server.mjs b/boothforge-ai/apps/web/server.mjs
new file mode 100644
index 0000000..574ee5e
--- /dev/null
+++ b/boothforge-ai/apps/web/server.mjs
@@ -0,0 +1,52 @@
+import { createServer } from 'node:http';
+import next from 'next';
+import nextEnv from '@next/env';
+import { authorized, previewConfig, privateHeaders } from './lib/access.mjs';
+
+const dev = process.argv.includes('--dev');
+nextEnv.loadEnvConfig(process.cwd(), dev);
+previewConfig(); // Refuse to start a preview without credentials and an HTTPS origin.
+const port = Number(process.env.PORT || 3000);
+const hostname = process.env.BIND_HOST || '127.0.0.1';
+const app = next({ dev, hostname, port });
+await app.prepare();
+const handle = app.getRequestHandler();
+const failures = new Map();
+const server = createServer(async (req, res) => {
+  for (const [key, value] of Object.entries(privateHeaders)) res.setHeader(key, value);
+  if (!dev) res.setHeader('Strict-Transport-Security', 'max-age=31536000');
+  // Only liveness is anonymous; no client data or provider details are returned.
+  if (req.url === '/health' && ['GET', 'HEAD'].includes(req.method)) {
+    res.setHeader('Content-Type', 'application/json');
+    res.end(req.method === 'HEAD' ? undefined : '{"status":"ok"}');
+    return;
+  }
+  const ip = req.socket.remoteAddress || 'unknown'; // Never trust client-supplied X-Forwarded-For.
+  const now = Date.now();
+  for (const [key, attempt] of failures) if (attempt.until < now) failures.delete(key);
+  const attempt = failures.get(ip);
+  if (attempt?.count >= 20) {
+    res.writeHead(429, { 'Retry-After': String(Math.ceil((attempt.until - now) / 1000)) });
+    res.end('Too many authentication attempts');
+    return;
+  }
+  if (!authorized(req.headers.authorization)) {
+    if (failures.size >= 10000 && !attempt) { res.writeHead(429); res.end(); return; }
+    failures.set(ip, { count: (attempt?.count || 0) + 1, until: attempt?.until || now + 60000 });
+    res.writeHead(401, { 'WWW-Authenticate': 'Basic realm="BOOTHFORGE Private", charset="UTF-8"' });
+    res.end('Private preview: authentication required');
+    return;
+  }
+  if (Number(req.headers['content-length'] || 0) > 6 * 1024 * 1024) {
+    res.writeHead(413); res.end('Maximum request size is 6 MB'); return;
+  }
+  try { await handle(req, res); }
+  catch { if (!res.headersSent) res.writeHead(500); res.end('Request failed'); }
+});
+server.requestTimeout = 30000;
+server.headersTimeout = 15000;
+server.listen(port, hostname, () => console.log(`BOOTHFORGE web ready on ${hostname}:${port}`));
+for (const signal of ['SIGTERM', 'SIGINT']) process.on(signal, () => {
+  server.close(async () => { await app.close(); process.exit(0); });
+  setTimeout(() => process.exit(1), 10000).unref();
+});

@@ -0,0 +1,146 @@
+"""One-click local startup. Never calls AI providers or modifies an existing env file."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from urllib.request import urlopen
+import venv
+import webbrowser
+
+ROOT = Path(__file__).resolve().parents[1]
+API = ROOT / 'services' / 'api'
+WEB = ROOT / 'apps' / 'web'
+
+
+def free_port(start):
+    for port in range(start, start + 30):
+        with socket.socket() as listener:
+            try:
+                listener.bind(('127.0.0.1', port))
+                return port
+            except OSError:
+                continue
+    raise RuntimeError(f'No free local port near {start}. Close older application windows.')
+
+
+def run(command, cwd):
+    subprocess.run([str(item) for item in command], cwd=cwd, check=True)
+
+
+def wait_ready(process, url):
+    deadline = time.monotonic() + 90
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError('A server stopped before it was ready. See the error above.')
+        try:
+            with urlopen(url, timeout=2) as response:
+                if response.status == 200:
+                    return
+        except OSError:
+            time.sleep(0.2)
+    raise RuntimeError('Startup timed out. See the server messages above.')
+
+
+def npm_cli(node):
+    npm = shutil.which('npm') or shutil.which('npm.cmd')
+    if not npm:
+        raise RuntimeError('npm is missing. Install Node.js from https://nodejs.org/en/download')
+    path = Path(npm)
+    candidates = [path.resolve(), path.parent / 'node_modules/npm/bin/npm-cli.js',
+                  Path(node).parent / 'node_modules/npm/bin/npm-cli.js',
+                  path.parent.parent / 'lib/node_modules/npm/bin/npm-cli.js']
+    for candidate in candidates:
+        if candidate.is_file() and candidate.name == 'npm-cli.js':
+            return [node, str(candidate)]
+    raise RuntimeError('Cannot find npm-cli.js. Reinstall the standard Node.js distribution.')
+
+
+def main():
+    parser = argparse.ArgumentParser(description='Start BOOTHFORGE locally and open its dashboard.')
+    parser.add_argument('--skip-install', action='store_true', help='Use already-installed dependencies')
+    parser.add_argument('--no-browser', action='store_true')
+    parser.add_argument('--smoke', action='store_true', help='Check startup with temporary data, then stop')
+    args = parser.parse_args()
+    if sys.version_info < (3, 11):
+        raise RuntimeError('Python 3.11+ is required: https://www.python.org/downloads/')
+    node = shutil.which('node')
+    if not node:
+        raise RuntimeError('Node.js 22+ is required: https://nodejs.org/en/download')
+    version = subprocess.check_output([node, '--version'], text=True).strip()
+    if int(version.lstrip('v').split('.')[0]) < 22:
+        raise RuntimeError('Please install Node.js 22 or newer: https://nodejs.org/en/download')
+    python = API / '.venv' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
+    if not python.exists():
+        if args.skip_install:
+            raise RuntimeError('Python dependencies are missing. Run without --skip-install first.')
+        print('Preparing the local Python environment...', flush=True)
+        venv.create(API / '.venv', with_pip=True)
+    if not args.skip_install:
+        print('Installing/verifying API dependencies...', flush=True)
+        run([python, '-m', 'pip', 'install', '-r', 'requirements.txt'], API)
+        print('Installing the web dependencies...', flush=True)
+        run([*npm_cli(node), 'ci'], WEB)
+    if not (WEB / 'node_modules' / 'next').is_dir():
+        raise RuntimeError('Web dependencies are missing. Run without --skip-install first.')
+    api_port, web_port = free_port(8000), free_port(3000)
+    url = f'http://localhost:{web_port}'
+    env = dict(os.environ)
+    # Explicit loopback-only development. No public preview setting is changed.
+    for key in list(env):
+        if key.startswith(('OPENAI_', 'GOOGLE_', 'GEMINI_')):
+            del env[key]
+    env.update(BOOTHFORGE_ENV='development', BIND_HOST='127.0.0.1', PORT=str(web_port),
+               API_INTERNAL_URL=f'http://127.0.0.1:{api_port}', APP_ORIGIN=url,
+               API_TOKEN='', PREVIEW_USERNAME='', PREVIEW_PASSWORD='', NEXT_TELEMETRY_DISABLED='1')
+    children = []
+    temporary = tempfile.TemporaryDirectory(prefix='boothforge-launcher-') if args.smoke else None
+    env['DATA_DIR'] = temporary.name if temporary else str(API / 'data')
+    try:
+        api = subprocess.Popen([str(python), '-m', 'uvicorn', 'app.main:app', '--host', '127.0.0.1',
+                                '--port', str(api_port), '--no-access-log'], cwd=API, env=env)
+        children.append(api)
+        wait_ready(api, f'http://127.0.0.1:{api_port}/health')
+        web = subprocess.Popen([node, 'server.mjs', '--dev'], cwd=WEB, env=env)
+        children.append(web)
+        wait_ready(web, f'http://127.0.0.1:{web_port}/health')
+        print(f'\nBOOTHFORGE is ready: {url}\nKeep this window open. Press Ctrl+C to stop.\n', flush=True)
+        if args.smoke:
+            with urlopen(url, timeout=60) as response:
+                assert response.status == 200 and b'BOOTHFORGE' in response.read(), 'Dashboard did not render'
+            with urlopen(url + '/api/projects', timeout=15) as response:
+                assert response.status == 200 and json.load(response) == [], 'The API proxy did not respond'
+            print('PASS: one-click launcher rendered Next.js and connected to FastAPI; no AI calls.', flush=True)
+            return
+        if not args.no_browser:
+            webbrowser.open(url)
+        while all(child.poll() is None for child in children):
+            time.sleep(0.5)
+        raise RuntimeError('A server stopped. See the error above, then restart this launcher.')
+    finally:
+        for child in reversed(children):
+            if child.poll() is None:
+                child.terminate()
+        for child in reversed(children):
+            try:
+                child.wait(timeout=15)
+            except subprocess.TimeoutExpired:
+                child.kill()
+                child.wait()
+        if temporary:
+            temporary.cleanup()
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except KeyboardInterrupt:
+        print('\nBOOTHFORGE stopped.')
+    except (RuntimeError, OSError, subprocess.SubprocessError, AssertionError) as exc:
+        print(f'\nStartup failed: {exc}\n', file=sys.stderr)
+        sys.exit(1)

+FROM node:22-bookworm-slim AS web-build
+WORKDIR /build/web
+ENV NEXT_TELEMETRY_DISABLED=1
+COPY apps/web/package.json apps/web/package-lock.json ./
+RUN npm ci
+COPY apps/web/ ./
+RUN npm run build && npm prune --omit=dev
+
+FROM node:22-bookworm-slim AS runtime
+RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
+    && rm -rf /var/lib/apt/lists/*
+WORKDIR /app
+COPY services/api/requirements.txt /tmp/requirements.txt
+RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
+COPY --from=web-build /build/web /app/apps/web
+COPY services/api/app /app/services/api/app
+COPY scripts/run_preview.py /app/scripts/run_preview.py
+RUN useradd --create-home --uid 10001 boothforge && mkdir -p /app/data \
+    && chown -R boothforge:boothforge /app
+USER boothforge
+ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 BOOTHFORGE_ENV=preview \
+    BIND_HOST=0.0.0.0 PORT=10000 API_INTERNAL_URL=http://127.0.0.1:8000 DATA_DIR=/app/data
+EXPOSE 10000
+CMD ["/opt/venv/bin/python", "scripts/run_preview.py"]

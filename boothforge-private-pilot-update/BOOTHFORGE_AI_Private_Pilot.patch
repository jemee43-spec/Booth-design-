+@echo off
+chcp 65001 >nul
+setlocal
+cd /d "%~dp0"
+echo BOOTHFORGE AI - Local startup
+echo Keep this window open while using the application.
+where py >nul 2>nul
+if not errorlevel 1 (
+    py -3 "%~dp0boothforge-ai\scripts\start_local.py"
+) else (
+    python "%~dp0boothforge-ai\scripts\start_local.py"
+)
+if errorlevel 1 (
+    echo.
+    echo Startup failed. Keep the error above for troubleshooting.
+    echo Requirements: Python 3.11+ and Node.js 22+.
+    echo Python: https://www.python.org/downloads/
+    echo Node.js: https://nodejs.org/en/download
+    pause
+)
+endlocal

+"""Run production-mode browser tests with synthetic data and disposable localhost TLS."""
+import os
+from pathlib import Path
+import secrets
+import ssl
+import subprocess
+import sys
+import tempfile
+import time
+from urllib.request import urlopen
+
+ROOT=Path(__file__).resolve().parents[1]
+
+
+def main():
+    children=[]
+    with tempfile.TemporaryDirectory(prefix='boothforge-browser-test-') as directory:
+        folder=Path(directory)
+        env={**os.environ,'BOOTHFORGE_ENV':'preview','API_TOKEN':secrets.token_urlsafe(32),
+             'PREVIEW_USERNAME':'pilot','PREVIEW_PASSWORD':secrets.token_urlsafe(24),
+             'APP_ORIGIN':'https://localhost:3443','DATA_DIR':str(folder/'data'),'PORT':'3100',
+             'BIND_HOST':'127.0.0.1','NEXT_TELEMETRY_DISABLED':'1',
+             'E2E_TLS_KEY':str(folder/'localhost.key'),'E2E_TLS_CERT':str(folder/'localhost.crt')}
+        env['BOOTHFORGE_E2E_USERNAME']=env['PREVIEW_USERNAME']
+        env['BOOTHFORGE_E2E_PASSWORD']=env['PREVIEW_PASSWORD']
+        subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-days','1',
+                        '-keyout',env['E2E_TLS_KEY'],'-out',env['E2E_TLS_CERT'],
+                        '-subj','/CN=localhost','-addext','subjectAltName=DNS:localhost'],
+                       check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+        with (folder/'runtime.log').open('w') as log:
+            try:
+                server=subprocess.Popen([sys.executable,str(ROOT/'scripts/run_preview.py')],env=env,stdout=log,stderr=log)
+                children.append(server)
+                for _ in range(200):
+                    if server.poll() is not None:
+                        raise RuntimeError('The test server failed to start')
+                    try:
+                        with urlopen('http://127.0.0.1:3100/health',timeout=1) as response:
+                            if response.status==200:break
+                    except OSError:time.sleep(0.1)
+                else:raise RuntimeError('Readiness timed out')
+                proxy=subprocess.Popen(['node','e2e/https-proxy.mjs'],cwd=ROOT/'apps/web',env=env,stdout=log,stderr=log)
+                children.append(proxy)
+                tls_context=ssl.create_default_context(cafile=env['E2E_TLS_CERT'])
+                for _ in range(100):
+                    if proxy.poll() is not None:
+                        raise RuntimeError('Local TLS proxy failed to start')
+                    try:
+                        with urlopen('https://localhost:3443/health',context=tls_context,timeout=1) as response:
+                            if response.status==200:break
+                    except OSError:time.sleep(0.1)
+                else:raise RuntimeError('Local TLS readiness timed out')
+                subprocess.run(['node','node_modules/@playwright/test/cli.js','test'],
+                               cwd=ROOT/'apps/web',env=env,check=True)
+            finally:
+                for child in reversed(children):
+                    if child.poll() is None:child.terminate()
+                for child in reversed(children):
+                    try:child.wait(timeout=20)
+                    except subprocess.TimeoutExpired:
+                        child.kill();child.wait()
+
+
+if __name__=='__main__':main()

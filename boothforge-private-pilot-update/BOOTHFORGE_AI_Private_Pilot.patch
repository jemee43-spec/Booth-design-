+import { test, expect } from '@playwright/test';
+
+test('create a booth with its requirements on a responsive Arabic dashboard', async ({page,request}, info) => {
+  await page.goto('/');
+  await expect(page.getByRole('heading',{name:'BOOTHFORGE AI'})).toBeVisible();
+  await expect(page.locator('html')).toHaveAttribute('dir','rtl');
+  const name=`Browser ${info.project.name} ${Date.now()}`;
+  await page.getByLabel('اسم المشروع',{exact:true}).fill(name);
+  await page.getByLabel('اسم العميل',{exact:true}).fill('Synthetic client');
+  await page.getByLabel('نشاط الشركة',{exact:true}).fill('Events');
+  await page.getByLabel('الطول بالمتر',{exact:true}).fill('8');
+  await page.getByLabel('العرض بالمتر',{exact:true}).fill('6');
+  await page.getByLabel('الشاشات',{exact:true}).fill('3');
+  await page.getByLabel('مستودع',{exact:true}).check();
+  await page.getByLabel('ملاحظات',{exact:true}).fill('Synthetic requirements from browser test');
+  await expect(page.getByText('المساحة: 48.00 م²',{exact:true})).toBeVisible();
+  await page.getByRole('button',{name:'إنشاء المشروع',exact:true}).click();
+  await expect(page.getByText(name,{exact:true})).toBeVisible();
+  const projects=await (await request.get('/api/projects')).json();
+  const project=projects.find((p:{name:string})=>p.name===name);
+  expect(project.area_m2).toBe(48);
+  expect(project.requirements.screens).toBe(3);
+  expect(project.requirements.storage).toBe(true);
+  expect(project.requirements.notes).toBe('Synthetic requirements from browser test');
+  expect(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth)).toBe(true);
+  await page.screenshot({path:info.outputPath('dashboard.png'),fullPage:true});
+});
+
+test('invalid height never submits a project', async ({page}) => {
+  await page.goto('/');
+  await page.getByLabel('اسم المشروع',{exact:true}).fill('Invalid height');
+  await page.getByLabel('اسم العميل',{exact:true}).fill('Test client');
+  await page.getByLabel('نشاط الشركة',{exact:true}).fill('Events');
+  const input=page.getByLabel('الارتفاع بالمتر',{exact:true});
+  await input.fill('21');
+  let writes=0;
+  page.on('request',req=>{if(req.url().endsWith('/api/projects')&&req.method()==='POST')writes++;});
+  await page.getByRole('button',{name:'إنشاء المشروع',exact:true}).click();
+  expect(await input.evaluate((node:HTMLInputElement)=>node.validity.rangeOverflow)).toBe(true);
+  expect(writes).toBe(0);
+});
+
+test('client-entered markup is displayed as text', async ({page}) => {
+  await page.goto('/');
+  const name='<img src=x onerror="document.body.dataset.compromised=1">';
+  await page.getByLabel('اسم المشروع',{exact:true}).fill(name);
+  await page.getByLabel('اسم العميل',{exact:true}).fill('Synthetic client');
+  await page.getByLabel('نشاط الشركة',{exact:true}).fill('Events');
+  await page.getByRole('button',{name:'إنشاء المشروع',exact:true}).click();
+  await expect(page.locator('article').filter({hasText:name}).first()).toBeVisible();
+  expect(await page.locator('article img').count()).toBe(0);
+  expect(await page.locator('body').getAttribute('data-compromised')).toBeNull();
+});
+
+test('recover after an API connection failure', async ({page}) => {
+  await page.route('**/api/projects',route=>route.abort());
+  await page.goto('/');
+  await expect(page.getByRole('alert',{name:'رسالة خطأ',exact:true})).toBeVisible();
+  await page.unroute('**/api/projects');
+  await page.getByRole('button',{name:'تحديث المشاريع',exact:true}).click();
+  await expect(page.getByRole('alert',{name:'رسالة خطأ',exact:true})).toHaveCount(0);
+});

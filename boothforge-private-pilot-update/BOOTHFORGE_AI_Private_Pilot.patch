@@ -0,0 +1,45 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+
+export function previewConfig(env = process.env) {
+  const mode = env.BOOTHFORGE_ENV || 'preview';
+  if (!['preview', 'development', 'test'].includes(mode)) throw new Error('Invalid BOOTHFORGE_ENV');
+  const development = mode === 'development';
+  if (!development && (!env.PREVIEW_USERNAME || (env.PREVIEW_PASSWORD || '').length < 24 || (env.API_TOKEN || '').length < 32)) {
+    throw new Error('Set PREVIEW_USERNAME, PREVIEW_PASSWORD (24+ characters) and API_TOKEN (32+ characters) securely');
+  }
+  if (!development && !/^https:\/\/[^/]+$/.test(env.APP_ORIGIN || '')) {
+    throw new Error('Set APP_ORIGIN to the exact HTTPS preview origin');
+  }
+  return { development, username: env.PREVIEW_USERNAME || '', password: env.PREVIEW_PASSWORD || '' };
+}
+
+function equal(a, b) {
+  return timingSafeEqual(createHash('sha256').update(a).digest(), createHash('sha256').update(b).digest());
+}
+
+export function authorized(header, env = process.env) {
+  let config;
+  try { config = previewConfig(env); } catch { return false; }
+  if (config.development && !config.username && !config.password) return true;
+  if (typeof header !== 'string' || header.length > 2048 || !header.startsWith('Basic ')) return false;
+  const value = Buffer.from(header.slice(6), 'base64').toString('utf8');
+  const separator = value.indexOf(':');
+  if (separator < 0) return false;
+  const userOK = equal(value.slice(0, separator), config.username);
+  const passOK = equal(value.slice(separator + 1), config.password);
+  return userOK && passOK;
+}
+
+export function allowedOrigin(origin, env = process.env) {
+  const expected = env.APP_ORIGIN || (env.BOOTHFORGE_ENV === 'development' ? 'http://localhost:3000' : '');
+  return Boolean(expected && origin === expected);
+}
+
+export const privateHeaders = {
+  'Cache-Control': 'no-store',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Robots-Tag': 'noindex, nofollow, noarchive',
+  'Referrer-Policy': 'no-referrer',
+  'X-Frame-Options': 'DENY',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=()',
+};

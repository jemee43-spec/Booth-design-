+        if environment != 'development' and len(token) < 32:
+            raise RuntimeError('API_TOKEN must contain at least 32 characters')
+        data.mkdir(parents=True, exist_ok=True, mode=0o700)
+        data.chmod(0o700)
+        with connect() as db:
+            db.execute('PRAGMA journal_mode=WAL')

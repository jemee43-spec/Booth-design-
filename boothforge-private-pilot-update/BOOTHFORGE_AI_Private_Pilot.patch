+    Image.new('RGB', (16, 16), 'blue').save(image, format='PNG', pnginfo=metadata)
+    first = client.post(url, files={'file': ('../../unsafe.png', image.getvalue() + b'<script>bad</script>', 'image/png')})
+    assert first.status_code == 200
+    stored = tmp_path / 'uploads' / pid / first.json()['stored_as']
+    assert stored.exists()
+    assert b'<script>' not in stored.read_bytes()
+    with Image.open(stored) as clean:
+        assert 'private' not in clean.info
+    assert client.post(url, files={'file': ('second.png', image.getvalue(), 'image/png')}).status_code == 200
+    assert not stored.exists()
+    assert len(list((tmp_path / 'uploads' / pid).iterdir())) == 1
+    assert client.get('/uploads/' + pid + '/' + first.json()['stored_as']).status_code == 404
+

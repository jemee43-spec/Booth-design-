+import { NextRequest } from 'next/server';
+import { authorized, allowedOrigin, privateHeaders } from '../../../lib/access.mjs';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+const LIMIT = 6 * 1024 * 1024;
+const json = (status: number, detail: string) => Response.json({ detail }, { status, headers: privateHeaders });
+
+async function proxy(request: NextRequest, context: { params: Promise<{ path: string[] }> }) {
+  // Check again here, including when run through Next's own server by mistake.
+  if (!authorized(request.headers.get('authorization'))) return json(401, 'Authentication required');
+  if (request.method === 'POST' && !allowedOrigin(request.headers.get('origin'))) return json(403, 'Untrusted origin');
+  const { path } = await context.params;
+  const joined = path.join('/');
+  const valid = /^projects(?:\/[0-9a-f-]{36}(?:\/(?:brand|concepts))?)?$/.test(joined);
+  const methodOK = request.method === 'GET' ? !/\/(brand|concepts)$/.test(joined) : joined === 'projects' || /\/(brand|concepts)$/.test(joined);
+  if (!valid || !methodOK || request.nextUrl.search) return json(404, 'Not found');
+  const target = process.env.API_INTERNAL_URL || 'http://127.0.0.1:8000';
+  const token = process.env.API_TOKEN || '';
+  if (!token && process.env.BOOTHFORGE_ENV !== 'development') return json(503, 'API is not configured');
+  let body: Uint8Array | undefined;
+  if (request.method === 'POST') {
+    const reader = request.body?.getReader();
+    const chunks: Uint8Array[] = [];
+    let size = 0;
+    if (reader) {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        size += value.byteLength;
+        if (size > LIMIT) { await reader.cancel(); return json(413, 'Maximum request size is 6 MB'); }
+        chunks.push(value);
+      }
+    }
+    body = new Uint8Array(size);
+    let offset = 0;
+    for (const chunk of chunks) { body.set(chunk, offset); offset += chunk.byteLength; }
+  }
+  try {
+    const headers: Record<string, string> = {};
+    if (token) headers.Authorization = `Bearer ${token}`;
+    if (request.headers.get('content-type')) headers['Content-Type'] = request.headers.get('content-type')!;
+    const response = await fetch(`${target}/${joined}`, {
+      method: request.method, headers, body: body as BodyInit | undefined,
+      cache: 'no-store', redirect: 'error', signal: AbortSignal.timeout(20000),
+    });
+    // Do not forward upstream cookies, credentials or internal exception details.
+    if (response.status >= 500 && response.status !== 501) return json(502, 'تعذر الاتصال بخادم المشاريع. حاول مجددًا.');
+    return new Response(await response.arrayBuffer(), {
+      status: response.status, headers: { ...privateHeaders, 'Content-Type': 'application/json' },
+    });
+  } catch { return json(502, 'تعذر الاتصال بخادم المشاريع. حاول مجددًا.'); }
+}
+
+export { proxy as GET, proxy as POST };

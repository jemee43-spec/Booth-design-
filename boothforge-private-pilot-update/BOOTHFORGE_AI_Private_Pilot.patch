+const env = { BOOTHFORGE_ENV: 'preview', PREVIEW_USERNAME: 'pilot', PREVIEW_PASSWORD: 'a-test-only-password-long-enough', API_TOKEN: 'test-token-long-enough-for-32-characters', APP_ORIGIN: 'https://pilot.example.test' };
+const basic = (value) => `Basic ${Buffer.from(value).toString('base64')}`;
+
+test('preview fails closed with missing or short secrets and an insecure origin', () => {
+  for (const key of ['PREVIEW_USERNAME', 'PREVIEW_PASSWORD', 'API_TOKEN', 'APP_ORIGIN']) {
+    const missing = { ...env, [key]: '' };
+    assert.throws(() => previewConfig(missing));
+    assert.equal(authorized(basic(`${env.PREVIEW_USERNAME}:${env.PREVIEW_PASSWORD}`), missing), false);
+  }
+  assert.throws(() => previewConfig({ ...env, APP_ORIGIN: 'http://example.test' }));
+  assert.throws(() => previewConfig({ ...env, BOOTHFORGE_ENV: 'typo' }));
+});
+test('only exact credentials work, including passwords containing colons and Unicode', () => {
+  assert.equal(authorized(basic(`pilot:${env.PREVIEW_PASSWORD}`), env), true);
+  for (const header of [undefined, '', 'Bearer anything', 'Basic !!!', basic('missing-colon'), basic('pilot:wrong'), basic(`wrong:${env.PREVIEW_PASSWORD}`), 'x'.repeat(3000)]) assert.equal(authorized(header, env), false);
+  const other = { ...env, PREVIEW_PASSWORD: 'a-long-password:with:colon-العربية' };
+  assert.equal(authorized(basic(`pilot:${other.PREVIEW_PASSWORD}`), other), true);
+});
+test('CSRF origin is explicit and exact', () => {
+  assert.equal(allowedOrigin(env.APP_ORIGIN, env), true);
+  for (const origin of [null, '', 'null', 'https://evil.example', 'https://pilot.example.test.evil.test']) assert.equal(allowedOrigin(origin, env), false);
+});
+test('anonymous local mode requires explicit development setting', () => {
+  assert.equal(authorized(undefined, {}), false);
+  assert.equal(authorized(undefined, { BOOTHFORGE_ENV: 'development' }), true);
+});
